<AuBodyContainer>
  <section
    class="au-u-flex au-u-flex--end@small au-u-flex--wrap au-u-height-full au-u-flex--column-reverse@small"
  >
    <article
      class="au-u-1-1 au-u-1-2@small au-u-flex au-u-flex--center au-u-padding"
    >
      <img
        src="/assets/images/homepage-visual.svg"
        class="au-u-max-width-small au-u-1-1"
        alt="Homepage visual"
      />
    </article>
    <article
      class="au-u-background-gray-100 au-u-1-1 au-u-1-2@small au-u-flex au-u-flex--column au-u-flex--center au-u-flex--vertical-center"
    >
      <AuContent
        class="au-u-flex au-u-flex--column au-u-flex--center au-u-padding au-u-max-width-small au-u-height-full"
      >
        <AuHeading @level="1" @skin="2">Get an insight into the impact of local
          authorities' decisions on the Sustainable Development Goals.</AuHeading>

        <p>To start, choose the local authority.</p>

        <div class="au-o-flow au-o-flow--small">
          <PowerSelectMultiple
            @searchEnabled={{true}}
            @id="municipality"
            @label="Local authority"
            @options={{this.governmentList.options}}
            @noMatchesMessage="No local authorities found"
            @selected={{this.governmentList.selected}}
            @onChange={{this.handleSelectLocalGovernmentsChange}}
            @searchField="label"
            @placeholder="Local authority"
            as |option|
          >
            {{option.label}}
          </PowerSelectMultiple>

          <AuButton
            @loading={{this.loading}}
            @loadingMessage="Laden..."
            @width="block"
            {{on "click" this.handleMunicipalitySelect}}
          >View</AuButton>
        </div>

      </AuContent>
      <p class="au-u-text-center au-u-margin-bottom">
        <AuLink @route="help">More information about this project</AuLink>
      </p>
    </article>
  </section>
</AuBodyContainer>